# Environment Variables Configuration for Render / Production Deployment

# Server Port (Set dynamically by Render)
PORT=3000

# Zoho Catalyst QuickML Credentials
QUICKML_ENDPOINT=https://api.catalyst.zoho.in/quickml/v1/project/<YOUR_PROJECT_ID>/glm/chat
QUICKML_ACCESS_TOKEN=your_quickml_access_token
CATALYST_ORG_ID=your_catalyst_org_id
